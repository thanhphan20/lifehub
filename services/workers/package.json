{
  "name": "lifehub-workers",
  "version": "1.0.0",
  "description": "Unified worker and consumer services for LifeHub",
  "main": "dist/main.js",
  "scripts": {
    "start": "ts-node src/main.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "worker:analytics": "ts-node src/main.ts analytics",
    "worker:notion": "ts-node src/main.ts notion",
    "worker:integration": "ts-node src/main.ts integration"
  },
  "dependencies": {
    "@notionhq/client": "^3.1.3",
    "amqplib": "^0.10.9",
    "axios": "^1.6.0",
    "dotenv": "^16.5.0",
    "ioredis": "^5.8.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
