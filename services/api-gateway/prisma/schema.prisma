// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WorkoutLog {
  id               String           @id @default(uuid())
  type             String
  sets             Int
  reps             Int
  weight           Float
  correlationId    String?          @db.VarChar(255)
  enrichmentStatus EnrichmentStatus @default(NOT_REQUIRED)
  syncDetails      Json?            @default("{}")
  rawText          String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([correlationId, type])
  @@index([createdAt])
  @@index([type])
  @@index([correlationId])
  @@map("workout_logs")
}

model StravaToken {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  expiresAt    Int // unix timestamp
  updatedAt    DateTime @updatedAt

  @@map("strava_tokens")
}

model MoodLog {
  id               String           @id @default(uuid())
  rating           Int // 1-10 scale
  tags             String[] // Optional mood tags (calm, stressed, focused, etc.)
  notes            String? // Optional lightweight notes
  correlationId    String?          @db.VarChar(255)
  enrichmentStatus EnrichmentStatus @default(NOT_REQUIRED)
  syncDetails      Json?            @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([createdAt])
  @@index([rating])
  @@index([correlationId])
  @@map("mood_logs")
}

model MealLog {
  id               String           @id @default(uuid())
  description      String
  date             DateTime
  calories         Int
  protein          Float
  carbs            Float
  fat              Float
  correlationId    String?          @db.VarChar(255)
  enrichmentStatus EnrichmentStatus @default(NOT_REQUIRED)
  syncDetails      Json?            @default("{}")
  rawText          String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([date])
  @@index([correlationId])
  @@map("meal_logs")
}

model DailyEntry {
  id        String   @id @default(uuid())
  date      DateTime
  todos     Json // Array of { id, text, status: 'pending' | 'done' | 'skipped' }
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@map("daily_entries")
}

model Book {
  id          String     @id @default(uuid())
  title       String
  author      String?
  status      BookStatus @default(READING)
  progress    Int        @default(0) // Percentage 0-100
  rating      Int? // 1-5 stars
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("books")
}

model ReadingSession {
  id        String   @id @default(uuid())
  bookId    String
  pages     Int?
  minutes   Int?
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([date])
  @@map("reading_sessions")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  proficiency Int      @default(0) // 0-100 self-assessed
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("skills")
}

model SelfTest {
  id        String   @id @default(uuid())
  skillId   String
  score     Int? // Optional score (0-100)
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillId])
  @@index([date])
  @@map("self_tests")
}

enum BookStatus {
  READING
  COMPLETED
  WISHLIST
}

model Outbox {
  id        String       @id @default(uuid())
  eventType String
  payload   Json
  status    OutboxStatus @default(PENDING)
  retries   Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("outbox")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum EnrichmentStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
  FAILED
}
