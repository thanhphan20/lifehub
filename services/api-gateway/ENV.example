# Server Configuration
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://lifehub:lifehub_password@localhost:5432/lifehub?schema=public

# Kafka Configuration
# Use localhost:9094 for host access when running locally
# Use kafka:9092 when running inside Docker network
KAFKA_BROKER=localhost:9094

# RabbitMQ Configuration
RABBITMQ_URL=amqp://lifehub:lifehub_password@localhost:5672

# API Configuration
API_PREFIX=api

